# Copy to .env.production and fill in. Keep it out of version control.
APP_NAME="HRIS Payroll"
APP_DOMAIN=hris.example.com
APP_URL=https://hris.example.com
APP_TIMEZONE=Asia/Manila
# php artisan key:generate --show   (BACK THIS UP: encrypted data is unreadable without it)
APP_KEY=
APP_PREVIOUS_KEYS=
# php -r "echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

DB_CONNECTION=pgsql
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=

REDIS_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hris@example.com
MAIL_FROM_NAME="${APP_NAME}"

SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
LOG_LEVEL=warning
REQUIRE_2FA_ROLES=admin,payroll
HORIZON_MAX_PROCESSES=4
BACKUP_RETENTION_DAYS=14
BACKUP_AT=02:00

EMPLOYER_NAME=
EMPLOYER_TIN=
EMPLOYER_TIN_BRANCH=0000
EMPLOYER_RDO=
EMPLOYER_SSS_NO=
EMPLOYER_PHILHEALTH_NO=
EMPLOYER_PAGIBIG_NO=
EMPLOYER_BANK_COMPANY_CODE=
EMPLOYER_BANK_ACCOUNT_NO=
